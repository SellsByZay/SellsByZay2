body {
  font-family: Arial, sans-serif;
  background-color: #fff;
  color: #222;
  margin: 0;
  padding: 0;
}

header {
  background-color: #000;
  color: #fff;
  padding: 1em;
  text-align: center;
}

nav a {
  color: #fff;
  margin: 0 1em;
  text-decoration: none;
}

section {
  padding: 2em;
  text-align: center;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2em;
}

.product-card {
  border: 1px solid #ccc;
  width: 250px;
  padding: 1em;
  text-align: center;
}

.product-card img {
  width: 100%;
  height: auto;
}

button {
  background-color: #000;
  color: #fff;
  padding: 0.5em 1em;
  border: none;
  cursor: pointer;
}

button:hover {
  background-color: #444;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SellsByZay | Streetwear Essentials</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header>
    <h1>SellsByZay</h1>
    <nav>
      <a href="#home">Home</a>
      <a href="#shop">Shop</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <a href="#cart">Cart</a>
    </nav>
  </header>

  <section id="home">
    <h2>Heat Just Dropped</h2>
    <p>Premium Denim Tears & Sp5der Sets Available Now</p>
    <a href="#shop" class="btn">Shop Now</a>
  </section>

  <section id="shop">
    <h2>Shop</h2>
    <div class="product-grid">

      <!-- Denim Tears Hoodie -->
      <div class="product-card">
        <img src="images/denimtears_hoodie.jpg" alt="Denim Tears Hoodie">
        <h3>Denim Tears Hoodie</h3>
        <p>$150.00</p>
        <button>Add to Cart</button>
      </div>

      <!-- Denim Tears Set -->
      <div class="product-card">
        <img src="images/denimtears_set.jpg" alt="Denim Tears Set">
        <h3>Denim Tears Set (Hoodie + Pants)</h3>
        <p>$260.00</p>
        <button>Add to Cart</button>
      </div>

      <!-- Sp5der Hoodie -->
      <div class="product-card">
        <img src="images/sp5der_hoodie.jpg" alt="Sp5der Hoodie">
        <h3>Sp5der Hoodie</h3>
        <p>$150.00</p>
        <button>Add to Cart</button>
      </div>

      <!-- Sp5der Set -->
      <div class="product-card">
        <img src="images/sp5der_set.jpg" alt="Sp5der Set">
        <h3>Sp5der Set (Hoodie + Pants)</h3>
        <p>$260.00</p>
        <button>Add to Cart</button>
      </div>

    </div>
  </section>

  <section id="about">
    <h2>About Us</h2>
    <p>SellsByZay brings you exclusive drops of premium streetwear. We specialize in curated Denim Tears and Sp5der sets to elevate your style game.</p>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>Email: <a href="mailto:Xavierisok36@icloud.com">Xavierisok36@icloud.com</a></p>
    <p>Instagram: <a href="https://instagram.com/sellsbyzay" target="_blank">@sellsbyzay</a></p>
  </section>

  <footer>
    <p>© 2025 SellsByZay. All rights reserved.</p>
  </footer>
</body>
</html>
